<UserControl x:Class="DigitalBankingSystem.DeleteEditAcc_UC"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DigitalBankingSystem"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <StackPanel Background="White" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Label FontSize="15" FontWeight="Bold" Margin="5 0 0 0" FontFamily="Calibri">Please Enter your Bank Account Id:</Label>
        <TextBox x:Name="bankAccTB" Height="20" Width="300" HorizontalAlignment="Left" Margin="10 0 0 0"></TextBox>
        <Button Width="100" Margin="10" HorizontalAlignment="Center">Submit</Button>
    </StackPanel>
</UserControl>
