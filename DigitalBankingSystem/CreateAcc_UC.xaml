<UserControl x:Class="DigitalBankingSystem.CreateAcc_UC"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DigitalBankingSystem"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <StackPanel Background="White">
        <Label FontSize="15" FontWeight="Bold" Margin="5 0 0 0" FontFamily="Calibri">Please Enter your Full Name:</Label>
        <TextBox x:Name="userNameTB" Height="20" Width="300" HorizontalAlignment="Left" Margin="10 0 0 0"></TextBox>
        <Label FontSize="15" FontWeight="Bold" Margin="5 5 0 0" FontFamily="Calibri">Please Enter your Age:</Label>
        <TextBox x:Name="userAgeTB" Height="20" Width="50" HorizontalAlignment="Left" Margin="10 0 0 0"></TextBox>
        <Label FontSize="15" FontWeight="Bold" Margin="5 5 0 0" FontFamily="Calibri">Please Enter your National ID:</Label>
        <TextBox x:Name="userNationalIdTB" Height="20" Width="200" HorizontalAlignment="Left" Margin="10 0 0 0"></TextBox>
        <Label FontSize="15" FontWeight="Bold" Margin="5 5 0 0" FontFamily="Calibri">Please Enter your Company Name:</Label>
        <TextBox x:Name="userCompanyNameTB" Height="20" Width="200" HorizontalAlignment="Left" Margin="10 0 0 0"></TextBox>
        <Label FontSize="15" FontWeight="Bold" Margin="5 5 0 0" FontFamily="Calibri">Please Enter your Address:</Label>
        <TextBox x:Name="userAddressTB" Height="20" Width="200" HorizontalAlignment="Left" Margin="10 0 0 0"></TextBox>
        <Label FontSize="15" FontWeight="Bold" Margin="5 5 0 0" FontFamily="Calibri">Please choose account type:</Label>
        <RadioButton Content="Salary Account" Width="150" HorizontalAlignment="Left" Margin="10 5 0 0" IsChecked="True"></RadioButton>
        <RadioButton Content="Saving Account" Width="150" HorizontalAlignment="Left" Margin="10 5 0 0"></RadioButton>
        <RadioButton Content="Trading Account" Width="150" HorizontalAlignment="Left" Margin="10 5 0 0"></RadioButton>

        <Button Width="100" Height="30" HorizontalAlignment="Left" Margin="10">Proceed</Button>
    </StackPanel>
</UserControl>
