<UserControl x:Class="DigitalBankingSystem.CreateAcc_UC"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DigitalBankingSystem"
             mc:Ignorable="d" 

             d:DesignHeight="450" d:DesignWidth="800">
    <StackPanel Background="White" Margin="1,0,-1,0">
        <StackPanel.Resources>
            <Style TargetType="Label">
                <Setter Property="FontSize" Value="15" />
                <Setter Property="FontFamily" Value="Calibri" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="Margin" Value="5 0 0 0" />
            </Style>

            <Style TargetType="TextBox">
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="Margin" Value="10 0 0 0" />
            </Style>

            <Style TargetType="RadioButton">
                <Setter Property="Width" Value="150" />
                <Setter Property="Height" Value="20" />
                <Setter Property="Margin" Value="10 5 0 0" />
                <Setter Property="HorizontalAlignment" Value="Left" />
            </Style>
        </StackPanel.Resources>
        <Label>Please Enter your Full Name:</Label>
        <TextBox x:Name="userNameTB" Height="20" Width="300" TextChanged="userNameTB_TextChanged" />
        <Label>Please Enter your Age:</Label>
        <TextBox x:Name="userAgeTB" Height="20" Width="50" TextChanged="userAgeTB_TextChanged" />
        <Label>Please Enter your National ID:</Label>
        <TextBox x:Name="userNationalIdTB" Height="20" Width="200" TextChanged="userNationalIdTB_TextChanged" />
        <Label>Please Enter your Phone Number:</Label>
        <TextBox x:Name="userPhoneNumberTB" Height="20" Width="200" TextChanged="userPhoneNumberTB_TextChanged" />
        <Label>Please Enter your Address:</Label>
        <TextBox x:Name="userAddressTB" Height="20" Width="200" TextChanged="userAddressTB_TextChanged" />
        <Label>Please choose account type:</Label>
        <RadioButton Content="Salary Account" IsChecked="True" Checked="RadioButton_Checked" />
        <RadioButton Content="Saving Account" Checked="RadioButton_Checked" />
        <RadioButton Content="Trading Account" Checked="RadioButton_Checked" />

        <WrapPanel>
            <WrapPanel.Resources>
                <Style TargetType="Button">
                    <Style.Setters>
                        <Setter Property="Width" Value="100"></Setter>
                        <Setter Property="Height" Value="30"></Setter>
                        <Setter Property="Margin" Value="10"></Setter>
                        <Setter Property="HorizontalAlignment" Value="Left"></Setter>
                    </Style.Setters>
                </Style>
            </WrapPanel.Resources>
            <Button Name="SubmitButton" Click="SubmitButton_Click">Submit</Button>
            <Button Name="CancelButton" Click="CancelButton_Click">Cancel</Button>
        </WrapPanel>
        
    </StackPanel>
</UserControl>
